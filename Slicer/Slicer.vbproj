<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <!--
      Exe, not WinExe. The Slicer's first job is a scan that reports, and a
      WinExe detaches from the console so every Console.WriteLine goes nowhere
      unless the app calls AllocConsole itself. An OpenTK GameWindow opens
      perfectly well from a console subsystem app, so the window this grows
      into does not need the switch flipped - it just keeps its log.
    -->
    <OutputType>Exe</OutputType>
    <StartupObject>Program</StartupObject>
    <RootNamespace></RootNamespace>
    <OptionCompare>Text</OptionCompare>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <AssemblyName>Slicer</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- Same version nuTerra and SrtViewer pin, so all three agree on Vector3. -->
    <PackageReference Include="OpenTK" Version="4.7.1" />
  </ItemGroup>
</Project>
